{
	"name": "@elithrar/workers-hono-rate-limit",
	"version": "0.5.4",
	"type": "module",
	"description": "Hono-compatible middleware for rate limiting requests with Cloudflare Workers.",
	"scripts": {
		"test": "vitest run",
		"build": "unbuild",
		"typecheck": "tsc --noEmit",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"prepublishOnly": "npm run build"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/elithrar/workers-hono-rate-limit.git"
	},
	"homepage": "https://github.com/elithrar/workers-hono-rate-limit",
	"peerDependencies": {
		"hono": ">=4.4.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@cloudflare/workers-types": "^5.20261012.1",
		"hono": "^4.13.13",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"unbuild": "^3.6.1",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	}
}
